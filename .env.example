# Copy to .env.local to override. Every value has a default in src/config.ts.

# Base URL of the Moddy API (the Lineup routes live under /lineup).
VITE_API_BASE=https://api.moddy.app

# Public URL of this site (canonical links, sign-in redirects).
VITE_SITE_URL=https://lineup.moddy.app

# 1 = use the development mock API instead of api.moddy.app.
# Set by `npm run dev:mock` (see .env.mock). Never set it in production.
VITE_MOCK_API=
